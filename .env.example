# SentryQ Security Analysis Platform - Environment Variables
# Copy this file to .env and adjust values as needed

# Ollama Configuration
OLLAMA_HOST=localhost:11434
# Default model is auto-selected from installed Ollama models; set via the Settings UI

# Server Configuration
PORT=5336        # Canonical port env var (SENTRYQ_PORT is not read — use PORT)
SENTRYQ_BIND=127.0.0.1
# Set to 0.0.0.0 to allow LAN access (requires SENTRYQ_AUTH_TOKEN for security)

# Optional authentication token (recommended when SENTRYQ_BIND=0.0.0.0)
# SENTRYQ_AUTH_TOKEN=your-secret-token-here

# Scan timeout (default: 60 minutes)
SENTRYQ_SCAN_TIMEOUT_MINUTES=60

# AI Provider API Keys (optional — can also be configured in the web UI)
# SENTRYQ_CLAUDE_API_KEY=your-claude-api-key-here
# SENTRYQ_GEMINI_API_KEY=your-gemini-api-key-here
# SENTRYQ_CUSTOM_API_KEY=your-openai-compatible-api-key-here

# PR/MR Decoration (optional — token for posting inline comments on GitHub/GitLab PRs)
# SENTRYQ_PR_TOKEN=your-github-or-gitlab-token

# Webhook Notifications (optional — comma-separated URLs notified on scan completion)
# SENTRYQ_WEBHOOK_URLS=https://hooks.example.com/sentryq,https://hooks2.example.com/sentryq

# Frontend Configuration (for build time)
VITE_APP_VERSION=2.0.0
